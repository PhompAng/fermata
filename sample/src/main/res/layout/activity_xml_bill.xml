<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:fitsSystemWindows="true">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:padding="16dp">

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/title_xml"
			android:textAppearance="?android:attr/textAppearanceLarge" />

		<RadioGroup
			android:id="@+id/modeGroup"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp">

			<RadioButton
				android:id="@+id/modeViewModel"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/mode_viewmodel_asks" />

			<RadioButton
				android:id="@+id/modeUseCase"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/mode_usecase_asks" />
		</RadioGroup>

		<LinearLayout
			android:id="@+id/items"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:orientation="vertical" />

		<TextView
			android:id="@+id/lastOutcome"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp" />

		<Button
			android:id="@+id/reset"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:text="@string/reset" />
	</LinearLayout>
</ScrollView>
